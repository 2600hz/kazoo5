%% -*- mode: erlang; -*-
%% vim: set ft=erlang:

{minimum_otp_vsn, "26.2"}.
%% we can set this to true, we force/override specific versions while the deps need another
%% version. Even multiple deps have dependency on different version of a package.
%% But this also produces a lot of warnings, we can override the deps, but this is
%% cumbersome to maintain.
{deps_error_on_conflict, false}.
{validate_app_modules, true}.
{compiler_source_format, relative}.

{project_app_dirs, ["applications/*"
                   ,"core/*"
                    %% ,"deps/*" if we depend on make deps
                   ]}.

{shell, [{config, "rel/sys.config"}
         %% ,{name, kazoo_apps} %% use 'rebar3 shell --name kazoo_apps' instead
        ,{apps, [reloader]}
        ]}.

{relx, [{release, {kazoo_dev, {git, short}}
        ,[] %% rebar.config.scripts will adds all core and apps
        ,[{mode, dev}
         ,{include_src, false}
         ,{check_for_undefined_functions, true}
         ,{src_tests, true}
         ,{generate_start_script, true}
         ,{extended_start_script, true}
         ,{sys_config_src, "rel/rebar.dev.sys.config.src"}
         ,{vm_args_src, "rel/rebar.dev.vm.args.src"}
         ,{overlay, [{copy, "core/sup/priv/sup", "{{output_dir}}/bin/"}
                     %% adding these two files just in case someone wants to play with them
                     %% otherwise just use _build/default/rel/kazoo_dev/kazoo_dev
                    ,{copy, "rel/nodetool", "{{output_dir}}/bin/official_nodetool"}
                     %% rel_ver won't work in kazoo script, must be change to release_version
                    ,{template, "rel/kazoo", "{{output_dir}}/bin/official_kazoo"}
                    ,{chmod, 8#00755, "{{output_dir}}/bin/official_kazoo"}
                    ]
          }
         ]
        }
       ]}.

{erl_opts, [debug_info
           ,warnings_as_errors
           ,warn_export_all
           ,warn_missing_spec
           ,warn_unused_import
           ,warn_unused_vars
            %%  do not define lager_extra_sinks in top-level,
            %%  if you do, rebar override all apps that define extra sink
           ,{parse_transform, lager_transform}
           ]}.

{profiles, [{test, [{erl_opts, [nowarn_missing_spec
                               ,{d, 'PROPER'}
                               ,{d, 'TEST'}
                               ]}
                   ,{plugins, [rebar3_proper]}
                   ]}
           ]}.

{cover_enabled, true}.
{cover_export_enabled, true}.
{cover_opts, [verbose]}.

{proper_opts, [{to_file, user}
              ,{cover, true}
              ]}.

{plugins, [pc %% to compile c_src
          ,rebar3_run %% to run the first relx release in console mode
          ,rebar3_auto %% to open a rebar shell with auto compile/reload files
          ,rebar3_autotest %% to run tests with auto compile/reload
           %% ,rebar3_hex
           %% ,rebar_mix
          ]
}.

{overrides, [{override, hamcrest, [{plugins, []}]} %% https://github.com/erlang/rebar3/issues/1425
            ,{override, couchbeam, [{erl_opts, [{d, 'WITH_JIFFY'}]}]}
             %% overriding git:// url in deps. If url schema is git, rebar will try
             %% to be useful and uses port 9418 instead of normal 443 port
            ,{override, folsom, [{deps, [{bear, {git, "https://github.com/boundary/bear.git", {tag, "0.8.2"}}}
                                        ,{meck, {git, "https://github.com/eproxus/meck", {tag, "0.8.2"}}}
                                        ]
                                 }
                                ]
             }
            ,{override, jesse, [{deps, [{jsx, {git, "https://github.com/talentdeficit/jsx.git", {tag, "2.9.0"}}}
                                       ,{rfc3339, {git, "https://github.com/andreineculau/rfc3339.git", {tag, "0.2.1-r15-compat"}}}
                                       ]
                                }
                               ]
             }
            ,{del, [{erl_opts, [warnings_as_errors
                               ,warn_export_all
                               ,warn_missing_spec
                               ,warn_unused_import
                               ,warn_unused_vars
                               ]
                    }
                   ]
             }
            ]
}.

%% PLEASE: Keep this in sync with make/deps.mk
{deps, [erlydtl
       ,meck
       ,poolboy

       ,{amqp_client, "3.12.13"}

       ,{amqp_dist, {git, "https://github.com/2600hz/erlang-amqp_dist.git", {ref, "581d4b53"}}}

       ,{esaml, {git, "https://github.com/2600hz/erlang-esaml.git", {branch, "master"}}}

        %% deps for couchbeam, pinning this here
        %% becausev requierd hackney-1.6.4 version in couchbeam is retired/invalid
        %% on hex.pm and doesn't have deps as.
       ,{hackney, "1.6.5"}
        %% Based off latest commit on 'show' branch: "fix fetch, all, stream, show and view ddoc types"
       ,{couchbeam, {git, "https://github.com/2600hz/erlang-couchbeam", {ref, "2d29971c"}}}

       ,{cowboy, {git, "https://github.com/2600hz/erlang-cowboy", {tag, "2600hz"}}}

        %% used by kz_tracers
       ,{eflame, {git, "https://github.com/slfritchie/eflame", {ref, "7b0bb1a7e"}}}

        %% used by gen_smtp
       ,{eiconv, {git, "https://github.com/zotonic/eiconv", {tag, "1.0.0"}}}

        %% used to store tabulator events
       ,{epgsql, {git, "https://github.com/epgsql/epgsql", {tag, "4.5.0"}}}

        %% used by kazoo_documents, teletype, notify, crossbar, callflow
       ,{erlang_localtime, {git, "https://github.com/2600hz/erlang-localtime", {branch, "2600hz"}}}

        %% used by kazoo_attachments, merged in lazedo/erlazure add-start-link changes
       ,{erlazure, {git, "https://github.com/2600hz/erlang-erlazure.git", {ref, "88e041725"}}}

        %% used by kazoo_attachments and a crossbar test (cb_storage_tests)
       ,{erlcloud, {git, "https://github.com/2600hz/erlang-erlcloud", {tag, "3.5.16"}}}

        %% used by properly, webhooks
       ,{ersip, {git, "https://github.com/2600hz/erlang-ersip", {branch, "master"}}}

        %% used by teletype, notify, and fax
        %% latest commit to origin/2600Hz: Fixes for encoding email address in a single comma separated header line
       ,{gen_smtp, {git, "https://github.com/2600hz/erlang-gen_smtp", {ref, "3f80bfcd4"}}}

        %% used in some scripts/ and sup
       ,{getopt, {git, "https://github.com/2600hz/erlang-getopt", {tag, "v1.0.1"}}}

        %% used by kazoo_events, webseq, konami, acdc, ecallmgr, callflow
       ,{gproc, {git, "https://github.com/2600hz/erlang-gproc", {tag, "0.8.0"}}}

        %% used by kz_network_utils
       ,{inet_cidr, {git, "https://github.com/2600hz/erlang-inet_cidr.git", {tag, "1.0.2"}}}

        %% used by kazoo_schemas primarily
       ,{jesse, {git, "https://github.com/2600hz/jesse", {ref, "86174cc16f18002ad640e62b2b3a8d9bcb33b05d"}}}

        %% add an option to return error on duplicate key when decoding
        %% includes changes from lazedo/utf8
        %% used by kz_json, nklib, jesse, lager, maybe couchbeam if compiled
       ,{jiffy, {git, "https://github.com/2600hz/erlang-jiffy", {ref, "9ea1b35"}}}

        %% used everywhere
       ,{lager, {git, "https://github.com/2600hz/erlang-lager", {tag, "3.9.2"}}}

       ,{lager_syslog, {git, "https://github.com/2600hz/erlang-lager_syslog", {tag, "3.0.3"}}}

        %% used in tests for kazoo_voicemail, crossbar, teletype, and other deps
       ,{dep_meck, {git, "https://github.com/2600hz/erlang-meck", {tag, "0.8.13"}}}

        %% used by kzsip_uri and cb_registrations
       ,{nklib, {git, "https://github.com/2600hz/erlang-nklib", {tag, "v0.4.1"}}}

        %% appears unused
        %% ,{parse_trans, {git, "https://github.com/lazedo/parse_trans"}}

        %% used by a handful of core apps
       ,{plists, {git, "https://github.com/2600hz/erlang-plists", {tag, "1.0.0"}}}

        %% used by kazoo_proper, knm, kazoo_caches, kazoo_bindings, kz_util_tests, kazoo_token_buckets, kazoo_stdlib
        %% used by apps hotornot and callflow
       ,{proper, {git, "https://github.com/2600hz/erlang-proper", {tag, "v1.3"}}}

       ,{recon, {git, "https://github.com/2600hz/erlang-recon", {tag, "2.4.0"}}}

       ,{ra, {git, "https://github.com/2600hz/erlang-ra.git", {tag, "v1.1.2"}}}

       ,{ranch, {git, "https://github.com/2600hz/erlang-ranch", {tag, "1.7.1"}}}

        %% Development-related for reloading beam files
        %% see rel/dev.vm.args and fixture_shell in make/kz.mk
        %% commit adds makefile for compile/clean
       ,{reloader, {git, "https://github.com/2600hz/erlang-reloader", {ref, "de1e6c742"}}}

       ,{syslog, {git, "https://github.com/2600hz/erlang-syslog", {ref, "bbad537a1"}}}

        %% ,{wsock, {git, "https://github.com/madtrick/wsock", {tag, "1.1.7"}}}
        %% appears unused

        %% used by kazoo_ast to create OpenAPI 3
       ,{yamerl, {git, "https://github.com/2600hz/erlang-yamerl", {tag, "v0.7.0"}}}

        %% INI file parser
        %% used by kazoo_config_init
       ,{zucchini, {git, "https://github.com/2600hz/erlang-zucchini", {tag, "0.1.0"}}}

        %% used by hotornot
       ,{trie, {git, "https://github.com/2600hz/erlang-trie", {tag, "v1.7.5"}}}

       ,{cowlib, {git, "https://github.com/2600hz/erlang-cowlib", {tag, "2600hz-2.9.1"}}}

       ,{gun, {git, "https://github.com/2600hz/erlang-gun", {tag, "2600hz-2.0.0-pre.3"}}}

       ,{apns, {git, "https://github.com/2600hz/erlang-apns4erl.git", {tag, "2600hz-2.4.1"}}}

        %% used by hangups
       ,{folsom, {git, "https://github.com/2600hz/erlang-folsom", {tag, "0.8.2"}}}

        %% Firebase cloud messaging
        %% used by pusher
       ,{fcm, {git, "https://github.com/2600hz/erlang-fcm.git", {ref, "b2f68a4c6"}}}

        %% Homer encapsulation protocol
        %% merged lazedo/hep changes
        %% added specs for dialyzer happiness
        %% runtime code generation
       ,{hep, {git, "https://github.com/2600hz/hep-erlang", {ref, "5f18e91e4"}}}

       ,{meta, {git, "https://github.com/2600hz/erlang-meta", {tag, "0.1.3"}}}

        %% used by call_inspector
       ,{qrcode, {git, "https://github.com/2600hz/erlang-qrcode", {ref, "650d9bc0d3d052cb5689a4b4fda161eb8d72a888"}}}


        %% Detect OTP versions available given the codebase
       ,{geas, {git, "https://github.com/crownedgrouse/geas", {tag, "2.7.14"}}}

        %% used for WSDL->record and WSDL RPC calls
       ,{soap, {git, "https://github.com/2600hz/erlang-soap", {ref, "77b595ab133636a8dacb9dd7b5a81f873b5c1a5a"}}}

        %% XML lib
       ,{erlsom, {git, "https://github.com/2600hz/erlang-erlsom", {ref, "fb5f88a7635341520e3251b5354479ceee5fa8b1"}}}

        %% used by properly
       ,{certifi, {git, "https://github.com/certifi/erlang-certifi", {tag, "2.5.2"}}}
       ,{relx, {git, "https://github.com/erlware/relx", {tag, "v4.9.0"}}}
