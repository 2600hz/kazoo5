}.

{xref_warnings,false}.
{xref_checks,[undefined_function_calls
             ,undefined_functions
              %% ,locals_not_used %% Compilation discovers this
              %% ,exports_not_used %% Compilation discovers this
             ,deprecated_function_calls %% Concerns not kazoo
             ,deprecated_functions %% Concerns not kazoo
             ]}.

{xref_ignores, [
                %% ~.~.~.~.~.~.~.~.~.~.~.~.~
                %% Kazoo stuff first

                %% =============================
                %%  deprecated_functions
                %% =============================

                %% called by:
                %% asr_request:maybe_transcribe/1
                %% kapps_util:add_aggregate_device/2
                %% fax_maintenance:migrate_private_media/3
                %% fax_maintenance:recover_private_media/3
                %% media_mgr_maintenance:import_prompt/3
                {kz_datamgr,ensure_saved,2}
                %% kazoo_yodb:save_fun/1
               ,{kz_datamgr,ensure_saved,3}

                %% ~.~.~.~.~.~.~.~.~.~.~.~.~

                %% =============================
                %% UNDEFINED FUNCTIONS (due to old deprecated and removed funs)
                %% these are mostly deprecated functions, some of them are just for compatibility with older OTP
                %% a few are calls to optional dependencies
                %% =============================
               ,{cover,compile_beam,2} %% called by meck_cover:compile_beam_wrapper/1
               ,{cover,compile_beams,1} %% called by meck_cover:alter_cover/0
               ,{cover,get_term,1} %% called by meck_cover:get_terms/2
               ,{cover,write,2} %% called by meck_cover:write_term/1
                %% called by:
                %% nklib_log_gelf:message/3
                %% nklib_util:get_hwaddr/0
                %% nklib_util:uuid_4122/0
               ,{crypto,rand_bytes,1}
               ,{crypto,sha_mac,2} %% called by couchbeam_util:hmac/3
               ,{erlang,delete,1} %% called by eflame2:exp1/2
               ,{exometer,delete,1} %% called by metrics_exometer:delete/1
               ,{exometer,ensure,3} %% called by metrics_exometer:new/2
               ,{exometer,update_or_create,4} %% called by metrics_exometer:notify/3

                %% called by gproc_dist:handle_leader_cast/3
                %% called by gproc_dist:initiate_sync/3
               ,{gen_leader,alive,1}
                %% called by gproc_dist:handle_leader_cast/3
                %% called by gproc_dist:initiate_sync/3
                %% called by gproc_dist:send_sync_complete/3
               ,{gen_leader,broadcast,3}

               ,{gen_leader,leader_call,2} %% called by gproc_dist:leader_call/1
               ,{gen_leader,leader_cast,2} %% called by gproc_dist:from_leader/3
               ,{gen_leader,leader_cast,2} %% called by gproc_dist:leader_cast/1
               ,{gen_leader,leader_node,1} %% called by gproc_dist:handle_call/4
               ,{gen_leader,start_link,6} %% called by gproc_dist:start_link/1
               ,{gettext_compile,write_header,0} %% called by po_generator:generate_file/3

                %% called by po_generator:write_entries/1
                %% called by po_generator:write_fuzzy_entries/1
               ,{gettext_compile,write_pretty,2}

               ,{hamcrest,assert_that,2} %% called by meck_matcher:match_ignore/2
               ,{hamcrest,is_matcher,1} %% called by meck_matcher:is_hamcrest_matcher/1
               ,{lager_default_tracer,info,1} %% called by lager:status/0
               ,{oauth,header_params_encode,1} %% called by couchbeam_util:oauth_header/3
               ,{oauth,sign,6} %% called by couchbeam_util:oauth_header/3
               ,{pcouchbeam_httpc,db_url,1} %% called by couchbeam_view:show/4

                %% called by rabbit_env:context_to_app_env_vars/1
                %% called by rabbit_env:log_context/1
                %% called by rabbit_env:log_process_env/0
                %% called by rabbit_env:post_port_cmd_output/3

               ,{rabbit_log_prelaunch,debug,1}

                %% called by rabbit_env:context_to_app_env_vars/1
                %% called by rabbit_env:do_load_conf_env_file/3
                %% called by rabbit_env:load_conf_env_file/1
                %% called by rabbit_env:log_context/1
                %% called by rabbit_env:log_process_env/0
                %% called by rabbit_env:parse_conf_env_file_output1/2
                %% called by rabbit_env:post_port_cmd_output/3
               ,{rabbit_log_prelaunch,debug,2}

                %% called by rabbit_env:amqp_tcp_port/1
                %% called by rabbit_env:erlang_dist_tcp_port/1
               ,{rabbit_log_prelaunch,error,2}

               ,{rabbit_log_prelaunch,warning,2} %% called by rabbit_env:parse_conf_env_file_output2/2
               ,{ssl,seed,1} %% called by hackney_pool:init/1

                %% =============================
                %% DEPRECATING (in OTP 24+)
                %% =============================

                %% called by:
                %% couchbeam_util:hmac/3
                %% epgsql_scram:hmac/2
                %% erlazure:sign_string/2
                %% smtp_util:compute_cram_digest/2
               ,{crypto,hmac,3}

               ,{crypto,rand_uniform,2} %% called by nklib_util:randomize/1
               ,{gen_fsm,enter_loop,4} %% called by nklib_proc:do_start/6
               ,{gen_fsm,enter_loop,5} %% called by nklib_proc:do_start/6

                %% called by:
                %% jesse_json_path:parse_json_pointer_token/1
                %% lhttpc_lib:split_credentials/1
                %% nklib_headers:update_uri/3
               ,{http_uri,decode,1}

                %% called by:
                %% esaml_binding:encode_http_redirect/4
                %% esaml_binding:redirect_username_part/1
               ,{http_uri,encode,1}

               ,{http_uri,parse,1} %% called by jesse_state:combine_id/2
               ,{pg2,create,1} %% called by mirrored_supervisor:handle_call/3

                %% called by:
                %% mirrored_supervisor:fold/3
                %% mirrored_supervisor:handle_call/3
                %% mirrored_supervisor:handle_info/2
                %% mirrored_supervisor:tell_all_peers_to_die/2
               ,{pg2,get_members,1}

               ,{pg2,join,2} %% called by mirrored_supervisor:handle_call/3
               ,{random,seed,3} %% called by erlydtl_filters:seed/3

                %% called by:
                %% erlydtl_filters:uniform/1
                %% hackney_util:uniform/1
               ,{random,uniform,1}

                %% called by:
                %% folsom_sample_exdec:update/3
                %% folsom_sample_slide_uniform:update/2
                %% folsom_sample_uniform:update/2
               ,{random,uniform_s,2}
               ,{sources_parser,parse,1} %% called by i18n_manager:generate_pos/1
               ,{ssl,cipher_suites,0} %% called by hackney_ssl:ciphers/0
               ,{ssl,ssl_accept,3} %% called by ranch_ssl:handshake/3
               ,{sys,get_debug,3} %% called by gen_server2:format_status/2


                %% =============================
                %% need OTP >= 24
                %% =============================

               ,{os,env,0} %% called by rabbit_env:env_vars/0
               ]
}.

{dialyzer, [
            %% not perfect solution, this completely remove lager from type check
            %% what we really want is to silence unmatched_returns for lager function calls
            {exclude_mods, [lager]}
           ,{warnings, [error_handling %% functions that only return via exception
                        %% ,no_behaviours  %% suppress warnings about behaviour callbacks
                        %% ,no_contracts   %% suppress warnings about invalid contracts
                        %% ,no_fail_call   %% suppress warnings for failing calls
                        %% ,no_fun_app     %% suppress warnings for failing fun applications
                        %% ,no_improper_lists %% suppress warnings for improper list construction
                        %% ,no_match          %% suppress warnings for patterns that are unused
                        %% ,'no_missing_calls'  %% suppress warnings about calls to missing functions
                        %% ,no_opaque         %% suppress warnings for violating opaque data structures
                        %% ,no_return         %% suppress warnings for functions that never return a value
                        %% ,no_undefined_callbacks %% suppress warnings about behaviours with no -callback
                        %% ,no_unused         %% suppress warnings for unused functions
                        %% ,'race_conditions'   %% include warnings for possible race conditions
                       ,'underspecs'        %% warn when the spec is too loose
                        %% ,'unknown'           %% let warnings about unknown functions/types change exit status
                       ,'unmatched_returns' %% warn when function calls ignore structure return values
                        %% ,overspecs %% ignorable, mostly for Dialyzer devs
                        %% ,specdiffs
                       ]
            }
           ]
}.
